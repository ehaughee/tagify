{{ define "title"}}Playlists{{ end }}
{{ define "content" }}
<table class="striped">
  <thead>
    <tr>
      <td>
        Name
      </td>
      <td>
        Link
      </td>
    </tr>
  </thead>
  <tbody>
    {{ range .playlists }}
      <tr>
        <td>
          <a href="/playlists/{{ .ID }}">{{ .Name }}</a>
        </td>
        <td>
          <a class="secondary" href="{{ .ExternalURLs.spotify }}">Open in Spotify</a>
        </td>
      </tr>
    {{end}}
  </tbody>
</table>
{{ end }}